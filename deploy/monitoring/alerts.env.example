# Copy to .alerts.env in the repo root (gitignored, stays on this machine), fill in, then run
# node scripts/alerts.mjs. Steps:
#  1. Telegram: talk to @BotFather, /newbot, copy the token below. Send your new bot any message.
#  2. node scripts/alerts.mjs chat   prints your chat id; copy it below. node scripts/alerts.mjs ping tests it.
#  3. Grafana Cloud: Administration → Users and access → Service accounts → Add service account
#     (role Editor) → Add service account token. GRAFANA_URL is your stack's address.
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=
GRAFANA_URL=https://yourstack.grafana.net
GRAFANA_ALERTS_TOKEN=glsa_...
# Everyone in rooms, server-wide, if /etc/crateball/.env sets CRATEBALL_MAX_PLAYERS (default 90).
ALERT_PLAYER_CAP=90
