# Copy to .grafana.env in the repo root (gitignored), fill in from Grafana Cloud, then run
# sh scripts/monitoring.sh. Find the values at grafana.com → My Account → your stack:
#  - Prometheus → Details: "Remote Write Endpoint" and "Username / Instance ID"
#  - Loki → Details: URL (add /loki/api/v1/push) and "User"
#  - Access Policies: a token with the scopes metrics:write and logs:write
GRAFANA_PROM_URL=https://prometheus-prod-XX-prod-XX.grafana.net/api/prom/push
GRAFANA_PROM_USER=000000
GRAFANA_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_LOKI_USER=000000
GRAFANA_TOKEN=glc_...
