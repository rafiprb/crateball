{
  "title": "Crateball",
  "uid": "crateball",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "tags": ["crateball"],
  "templating": {
    "list": [
      {
        "name": "prom",
        "label": "Metrikler",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "loki",
        "label": "Loglar",
        "type": "datasource",
        "query": "loki"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Oyun",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Maç (seçili aralık)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"crateball\", msg=\"maç başladı\"}[$__range]))",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Odaya giriş",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"crateball\", msg=\"oyuncu odaya girdi\"}[$__range]))",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "R raporu",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"crateball\", msg=\"oyuncu raporu (R)\"}[$__range]))",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "Kopma",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"crateball\", msg=\"oyuncu koptu, yeri tutuluyor\"}[$__range]))",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 6,
      "title": "Açık oda",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(sum by (room) (count_over_time({job=\"crateball\", msg=\"oda istatistik\"} | json room=\"room\" [1m])))",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "legendFormat": "oda",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Oyundaki oyuncu",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(sum by (name) (count_over_time({job=\"crateball\", msg=\"istemci istatistik\"} | json name=\"name\" [1m])))",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "legendFormat": "oyuncu",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Bağlantı ve akıcılık (oyuncu başına)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "title": "Ping p95",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {job=\"crateball\", msg=\"istemci istatistik\"} | json name=\"name\", rtt=\"rtt\" | unwrap rtt [5m]) by (name)",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "legendFormat": "{{name}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Top düzeltmesi p95 (px)",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {job=\"crateball\", msg=\"istemci istatistik\"} | json name=\"name\", v=\"ballCorrectionMaxPx\" | unwrap v [5m]) by (name)",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "legendFormat": "{{name}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "FPS (en düşük)",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min_over_time({job=\"crateball\", msg=\"istemci istatistik\"} | json name=\"name\", fps=\"fps\" | unwrap fps [5m]) by (name)",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "legendFormat": "{{name}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "Sunucu: en yavaş tick",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max_over_time({job=\"crateball\", msg=\"oda istatistik\"} | json room=\"room\", v=\"stepMsMax\" | unwrap v [5m]) by (room)",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "legendFormat": "{{room}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "row",
      "title": "Raporlar ve hatalar",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 14,
      "title": "R raporları",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"crateball\", msg=\"oyuncu raporu (R)\"}",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 15,
      "title": "Uyarı ve hatalar",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"crateball\", level=~\"40|50|60\"} != \"oyuncu raporu\"",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 16,
      "type": "row",
      "title": "Sunucu",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 17,
      "title": "CPU",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{instance=\"crateball-prod\", mode=\"idle\"}[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "legendFormat": "kullanım"
        },
        {
          "refId": "B",
          "expr": "100 * avg(rate(node_cpu_seconds_total{instance=\"crateball-prod\", mode=\"steal\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "legendFormat": "steal"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 18,
      "title": "RAM",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 8,
        "y": 42,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemTotal_bytes{instance=\"crateball-prod\"} - node_memory_MemAvailable_bytes{instance=\"crateball-prod\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "legendFormat": "kullanılan"
        },
        {
          "refId": "B",
          "expr": "node_memory_MemTotal_bytes{instance=\"crateball-prod\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "legendFormat": "toplam"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 19,
      "title": "Disk (/)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 16,
        "y": 42,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{instance=\"crateball-prod\", mountpoint=\"/\"} / node_filesystem_size_bytes{instance=\"crateball-prod\", mountpoint=\"/\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "legendFormat": "dolu"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 20,
      "title": "Ağ",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 50,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(node_network_receive_bytes_total{instance=\"crateball-prod\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "legendFormat": "gelen"
        },
        {
          "refId": "B",
          "expr": "sum(rate(node_network_transmit_bytes_total{instance=\"crateball-prod\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "legendFormat": "giden"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      }
    },
    {
      "id": 21,
      "title": "Yük",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 50,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_load1{instance=\"crateball-prod\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "legendFormat": "1 dk"
        },
        {
          "refId": "B",
          "expr": "node_load5{instance=\"crateball-prod\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "legendFormat": "5 dk"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}
