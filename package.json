{
  "name": "crateball",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @crateball/server --filter @crateball/client dev",
    "build": "pnpm --filter @crateball/client build && pnpm --filter @crateball/server build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "netsim": "pnpm --filter @crateball/server exec tsx ../../tests/netsim/run.ts",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm e2e",
    "docker:prod": "sh scripts/docker-smoke.sh",
    "docker:stack": "sh scripts/docker-smoke.sh stack",
    "deploy": "sh scripts/deploy.sh",
    "logs": "sh scripts/server.sh 'journalctl -f -n 50 -o cat CONTAINER_TAG=crateball-game'",
    "watch": "sh scripts/server.sh 'journalctl -f -n 0 -o cat CONTAINER_TAG=crateball-game' | node scripts/watch.mjs",
    "crate-stats": "sh scripts/server.sh 'journalctl -o cat --since \"90 days ago\" CONTAINER_TAG=crateball-game | grep \"maç başladı\"' | node scripts/crate-stats.mjs"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
