{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "game",
  "description": "The game page may only toggle fullscreen (F11 / Alt+Enter) and record Steam stats and achievements.",
  "windows": ["main"],
  "remote": {
    "urls": ["https://playcrateball.com/*"]
  },
  "permissions": [
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "allow-steam-add-stats",
    "allow-steam-unlock"
  ]
}
